<Project>
    <!-- Importing the parent directory.build.props first is very important to maintain expected outcome of merging directory.build.props from multiple levels. -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

    <PropertyGroup>
        <!-- The AutoFixtures generator emits typeparam tags naming no type parameter (CS1711) and
             nullable annotations with no #nullable directive (CS8669). No source here to fix, and an
             .editorconfig severity does not reach a generator's output. -->
        <NoWarn>$(NoWarn);CS1711;CS8669</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- The one project that needs the assemblies as well as the analyzers: its tests name
             BoundaryAnalyzer and the fixes (B-015). Updates, not second ProjectReferences. -->
        <ProjectReference Update="$(TransporterAnalyzerProject)" ReferenceOutputAssembly="true"/>
        <ProjectReference Update="$(TransporterCodeFixProject)" ReferenceOutputAssembly="true"/>
    </ItemGroup>

</Project>
