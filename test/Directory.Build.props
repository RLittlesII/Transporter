<Project>
    <!-- Importing the parent directory.build.props first is very important to maintain expected outcome of merging directory.build.props from multiple levels. -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

    <PropertyGroup>
        <!-- The AutoFixtures generator writes AutoFixtureBase.g.cs into obj/ on every build with
             <typeparam> tags that name no type parameter (CS1711) and nullable annotations with no
             #nullable directive (CS8669). Both only surface because GenerateDocumentationFile and
             Nullable are on, there is no source here to correct, and an .editorconfig severity does
             not reach a source generator's output - so they are silenced on the project instead. -->
        <NoWarn>$(NoWarn);CS1711;CS8669</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- The analyzer is referenced for every project in the root Directory.Build.props, with
             ReferenceOutputAssembly="false" so no analyzer assembly reaches an application. The
             tests are the one place that needs the assembly too, because they name BoundaryAnalyzer
             in order to test it (boundary-analyzer B-015). An Update by $(TransponderAnalyzerProject)
             changes that one piece of metadata on the existing item; a second ProjectReference
             would be a second declaration of the same reference. -->
        <ProjectReference Update="$(TransponderAnalyzerProject)" ReferenceOutputAssembly="true"/>
    </ItemGroup>

</Project>
