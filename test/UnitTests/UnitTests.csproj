<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>Transponder.UnitTests</RootNamespace>
        <AssemblyName>Transponder.UnitTests</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AwesomeAssertions"/>
        <PackageReference Include="coverlet.collector"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="NSubstitute"/>
        <PackageReference Include="Rocket.Surgery.Extensions.Testing.AutoFixtures"/>
        <PackageReference Include="xunit"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/Transponder/Transponder.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="Integrations/OpenSky/Fixtures/*.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <!-- An analyzer reference, not an assembly reference: csc loads it and the application
             never sees it (B-014). ReferenceOutputAssembly="false" is what keeps
             Transponder.Analyzers.dll out of this project's output. -->
        <ProjectReference Include="../../src/Transponder.Analyzers/Transponder.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>