<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Akka" />
      <PackageReference Include="Akka.Hosting" />
      <PackageReference Include="DynamicData" />
      <PackageReference Include="Flurl.Http" />
      <PackageReference Include="LanguageExt.Core" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
      <PackageReference Include="Microsoft.Extensions.Hosting" />
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
      <PackageReference Include="Microsoft.Extensions.Options" />
      <PackageReference Include="System.Reactive" />
      <PackageReference Include="Microsoft.Maui.Controls.Core" />
      <PackageReference Include="ReactiveMarbles.Command" />
      <PackageReference Include="ReactiveMarbles.Mvvm" />
      <PackageReference Include="Riok.Mapperly" />
      <PackageReference Include="Rocket.Surgery.Airframe.Core" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Transponder.UnitTests" />
      <!-- Castle's dynamic proxy, which NSubstitute builds its doubles with. Every type under
           Integrations/ is internal, so a substitute for an internal interface needs this grant. -->
      <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="**\.issue\*.yml" />
      <Content Include="**\.spec\*.feature" />
      <Content Include="**\.spec\**\*.md" />
    </ItemGroup>

</Project>
