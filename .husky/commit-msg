#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

## IMPORTANT: husky re-execs this whole file as `sh -e "$0" "$@"`
## (.husky/_/husky.sh:24), so everything below runs under errexit. Each check
## captures its own exit status behind an `if !` guard and the script decides at
## the end, exactly as pre-commit does -- do not rewrite these into bare
## invocations.
##
## Checks the SUBJECT of the message against the convention
## `.skills/transponder-conventions/references/delivery.md` § "Commit and pull
## request messages" writes down. Only what that document states is checked
## here, and only on the subject: the body rules -- a paragraph per decision,
## the item line, the verification paragraph, what is still not true -- are
## about content a regular expression cannot read, and they are reviewed rather
## than gated. "No emoji" is likewise unenforced: BSD grep has no -P, and the
## character-class alternatives either miss most of the range or reject the § and
## em dash that every specification cite in this repository uses.
##
## $1 is the path to the message file, which is the only argument git passes.
message_file=$1
subject=$(grep -v '^#' "$message_file" | sed '/./,$!d' | head -1)

## Messages git composes itself, and the ones rebase consumes. A merge subject is
## "Merge branch ...", a revert is `Revert "..."`, and fixup!/squash!/amend!
## carry the subject of the commit they will be folded into. Rejecting any of
## them would break `git merge`, `git revert` and every interactive rebase.
case "$subject" in
    "Merge "* | "Revert "* | "fixup!"* | "squash!"* | "amend!"*)
        exit 0
        ;;
esac

subject_status=0

## type(scope)?!?: subject
##
## `feature` is spelled out, which is this repository's one departure from the
## conventional-commits vocabulary -- every item commit on main reads
## feature(0023), feature(0005).
##
## The scope names what the commit belongs to, and the vocabulary is explicit
## rather than a loose pattern:
##
##   0007          an item, four digits, repository-wide
##   fleet-pipeline  a Feature, by its slug
##   B-004         a claim
##   ADR-0009      an architecture decision record
##   TRN0004       an analyzer diagnostic
##
## `docs` takes any of them, because a documentation change is often about one
## element rather than a whole Feature. The slug is not checked against a
## directory, because a Feature's specification does not have to live under
## features/ -- aircraft-source's is under its integration. The scope is absent
## when the change belongs to none of these, which is every repository-wide
## chore. The shape is all this can check; which spelling is right is the
## reference's rule.
##
## The `!` is allowed for a breaking change because the standard uses it;
## nothing on main carries one yet.
##
## Grouped alternation and {} are ERE, so -E is required. The subject must start
## lowercase, or with a digit, or with a backtick, which is how a subject naming
## a type opens.
if ! printf '%s' "$subject" | grep -Eq '^(feature|docs|chore|refactor|fix|test|build|ci|perf|style|revert)(\(([0-9]{4}|B-[0-9]{3}|ADR-[0-9]{4}|TRN[0-9]{4}|[a-z][a-z0-9]*(-[a-z0-9]+)*)\))?!?: [a-z0-9`]'; then
    subject_status=1
    echo
    echo "commit-msg: the subject does not match this repository's convention."
    echo
    echo "    $subject"
    echo
    echo "Shape:  <type>(<item id>): <what is now true>"
    echo "Types:  feature docs chore refactor fix test build ci perf style revert"
    echo "Scope:  an item (0007), a Feature (fleet-pipeline), a claim (B-004),"
    echo "        a record (ADR-0009) or a diagnostic (TRN0004)."
    echo "        Absent when the change belongs to none of them."
    echo "Case:   lowercase after the colon."
    echo
    echo "    feature(0007): wrap the tracker seam in IFleetTracker and give it the clock"
    echo "    docs(fleet-pipeline): answer every open question, the architecture review included"
    echo "    docs(B-004): make the disposal claim falsifiable again"
    echo "    chore: gate the commit subject with a commit-msg hook"
    echo
    echo "Note feature, not feat. The rules are in"
    echo ".skills/transponder-conventions/references/delivery.md."
    echo
    echo "Bypass with: git commit --no-verify"
fi

## A trailing period on the subject. Separate from the pattern above so the
## message names the one thing that is wrong rather than printing the whole
## shape again.
period_status=0

case "$subject" in
    *.)
        period_status=1
        echo
        echo "commit-msg: the subject ends in a period. Drop it."
        echo
        echo "    $subject"
        echo
        echo "Bypass with: git commit --no-verify"
        ;;
esac

## One trailer, and it is checked because it has a syntax.
## `deliver-change` references/publish.md step 3 bans a co-author trailer, and
## `Co-authored-by:` at the start of a line is that trailer and nothing else, so
## the check cannot fire on anything a message legitimately says. Its one
## realistic author is an agent appending the line out of habit, which is the
## case worth catching: a person writing `git commit -m` does not produce one.
##
## Two bans the reference carries are deliberately NOT here. A generated-by line
## is prose, not syntax -- an unanchored `generated (with|by)` rejects "the
## mapper is generated by Mapperly" and "the workflow is generated by Nuke",
## which is what this repository's own conventions say about Mapperly,
## format.json and ci.yml. And emoji cannot be matched with BSD grep without
## also rejecting the § and the em dash every specification cite uses. Both stay
## rules a reader holds; see references/delivery.md.
trailer_status=0

if grep -Eiq '^co-authored-by:' "$message_file"; then
    trailer_status=1
    echo
    echo "commit-msg: the message carries a co-author trailer, which this"
    echo "repository does not use (deliver-change publish.md step 3)."
    echo
    grep -Ein '^co-authored-by:' "$message_file" | sed 's/^/    /'
    echo
    echo "Bypass with: git commit --no-verify"
fi

if [ "$subject_status" -ne 0 ] || [ "$period_status" -ne 0 ] || [ "$trailer_status" -ne 0 ]; then
    exit 1
fi
