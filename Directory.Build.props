<Project>
    <PropertyGroup>
        <!-- RSA2014 and RSA2015 read XML documentation comments off the syntax tree, and csc only
             parses them into the tree when it is asked for a documentation file. Without this,
             DocumentationMode is None, every /// comment is plain comment trivia, and both rules
             report missing documentation on members that are already documented. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Rocket.Surgery.Airframe.CodeAnalysis"/>
    </ItemGroup>

    <PropertyGroup>
        <!-- Named so the one project whose metadata differs can Update the item by the same
             evaluated path rather than by a second copy of it. -->
        <TransponderAnalyzerProject>$(MSBuildThisFileDirectory)src/Transponder.Analyzers/Transponder.Analyzers.csproj</TransponderAnalyzerProject>
    </PropertyGroup>

    <ItemGroup Condition="'$(MSBuildProjectName)' != 'Transponder.Analyzers'">
        <!-- This repository's own analyzer, referenced the same way and in the same place as the
             Airframe set above: every project the file governs gets it, including one added later.
             An analyzer reference, not an assembly reference — csc loads it and the application
             never sees it (boundary-analyzer B-014), which is what ReferenceOutputAssembly="false"
             keeps true. The test project flips that back with an Update, because its tests name
             BoundaryAnalyzer in order to test it.

             The path is anchored at this file rather than relative, because MSBuild resolves a
             ProjectReference against the project that imports it and the importers sit at three
             different depths. The condition keeps the analyzer out of its own reference list; a
             project cannot be its own analyzer. -->
        <ProjectReference Include="$(TransponderAnalyzerProject)"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>
</Project>
